syntax on
set background=dark
set colorcolumn=80
set expandtab
set incsearch
set noerrorbells
set number
set relativenumber
set shiftwidth=4
set showmatch
set smartcase
set smartindent
set t_Co=256
set tabstop=4 softtabstop=4
set termguicolors
set wildmenu
set wildmode=longest,full
highlight ColorColumn ctermbg=0 guibg=lightgrey
colorscheme gruvbox
let g:skip_defaults_vim = 1
